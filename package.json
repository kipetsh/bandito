{
  "name": "bandito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#js/*": "./js/*",
    "#assets/*": "./assets/*"
  },
  "description": "Bandito — browser card game",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node tools/copy-static.mjs && node tools/optimize-images.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown --ignore-path /dev/null .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint-staged": "lint-staged",
    "test:source": "node --test tests/source.test.mjs",
    "test:build": "node --test tests/build.test.mjs",
    "test": "npm run test:source && npm run build && npm run test:build",
    "check": "node tools/check.mjs",
    "check:fix": "npm run lint:fix && npm run format",
    "postinstall": "node tools/install-hooks.mjs",
    "dev:local": "vite --host 127.0.0.1 --strictPort",
    "dev:tauri": "vite --host 127.0.0.1 --strictPort",
    "app:icons": "npx --yes @tauri-apps/cli@2.12.4 icon src-tauri/icons/source.svg --output src-tauri/icons",
    "app:dev": "npx --yes @tauri-apps/cli@2.12.4 dev",
    "app:build": "npm run app:icons && npx --yes @tauri-apps/cli@2.12.4 build",
    "app:android:init": "npx --yes @tauri-apps/cli@2.12.4 android init --ci && npm run app:icons",
    "app:android:build": "npm run app:icons && npx --yes @tauri-apps/cli@2.12.4 android build --apk"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "sharp": "0.35.5",
    "vite": "8.3.6"
  }
}
