{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bandito",
  "version": "0.1.1",
  "identifier": "com.kipetsh.bandito",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "bandito://localhost"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bandito",
        "width": 1280,
        "height": 860,
        "minWidth": 620,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'", "customprotocol:", "asset:", "bandito:"],
        "script-src": ["'self'", "https://www.gstatic.com"],
        "style-src": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        "font-src": ["'self'", "https://fonts.gstatic.com", "data:"],
        "img-src": ["'self'", "asset:", "data:", "blob:", "https:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://*.firebaseio.com",
          "wss://*.firebaseio.com",
          "https://identitytoolkit.googleapis.com",
          "https://securetoken.googleapis.com",
          "https://www.googleapis.com",
          "https://bandito-83823.firebaseapp.com"
        ],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "frame-src": ["'self'", "https://bandito-83823.firebaseapp.com"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Карточная игра Bandito",
    "longDescription": "Одиночная и кооперативная карточная игра Bandito.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": {
      "minSdkVersion": 24
    }
  }
}
